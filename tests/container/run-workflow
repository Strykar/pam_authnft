#!/bin/bash
set -uo pipefail
WORKFLOW=$(cat /shared/workflow 2>/dev/null || echo unit)
echo "=== Workflow: $WORKFLOW ==="

cp -a /src/. /build/
cd /build

EC=0
case "$WORKFLOW" in
    unit)
        make clean && make && make test || EC=$?
        ;;
    integration)
        # We are root inside the container — skip the sudo that
        # Makefile's test-integration target prefixes onto each
        # command. sudo under a systemd unit with no tty either
        # requires a relaxed sudoers (Defaults !requiretty) or
        # drops stdout into the void. Invoking the scripts
        # directly is cleaner.
        make clean && make && make test \
          && ./tests/integration_test.sh "$(pwd)/pam_authnft.so" \
          && AUTHNFT_AUDIT_MODE=1 valgrind \
                --leak-check=full --show-leak-kinds=all \
                --error-exitcode=1 ./authnft_test \
          || EC=$?
        ;;
    trace)
        make clean && make && ./tests/trace.sh "$(pwd)/pam_authnft.so" || EC=$?
        cp -f trace.log trace-claims.log /shared/ 2>/dev/null || true
        ;;
    coverage)
        # Unit + integration tiers against one gcov-instrumented build,
        # so counters accumulate across both. Each gcov context (obj/
        # for the .so and main suite, one per standalone test binary)
        # is dumped to its own /shared/gcov/N dir; the host unions them
        # with tests/ci/coverage-union.py. Known structural loss: the
        # seccomp'd setup child _exit()s, which skips gcov flush, so
        # nft_handler's in-child increments never land; the fault
        # driver covers that file in-process instead.
        # The fault matrix (run-audit.sh) drives nft_handler's setup and
        # error paths in-process, where gcov can flush; the pamtester
        # path loses them to the setup child's _exit. Prebuilding the
        # driver and preloads instrumented means run-audit's own make
        # calls see fresh targets and skip the uninstrumented rebuild.
        # run-all.sh is NOT used here: its make clean would wipe the
        # gcda accumulated by the earlier suites.
        make clean && make CC="gcc --coverage" CFLAGS="-DAUTHNFT_COVERAGE" \
          && make test CC="gcc --coverage" CFLAGS="-DAUTHNFT_COVERAGE" \
          && ./tests/integration_test.sh "$(pwd)/pam_authnft.so" \
          && make tests/audit/nft_fault_driver tests/audit/malloc_fail.so \
                  tests/audit/nft_fail.so CC="gcc --coverage" \
          && ./tests/audit/run-audit.sh \
          && AUTHNFT_AUDIT_MODE=1 ./authnft_test \
          || EC=$?
        # Feature-path catalogue run (sock_diag, keyctl): same binary,
        # different stage selection; coverage only, failures tolerated.
        ./tests/trace_features.sh >/dev/null 2>&1 || true
        # gcov resolves the relative Source: paths against its cwd, so
        # it must run from /build where src/ exists; each context's
        # output is then moved aside before the next run overwrites it.
        n=0
        rm -f /build/*.gcov
        gcov -o /build/obj /build/src/*.c >/dev/null 2>&1 || true
        mkdir -p "/shared/gcov/$n" && mv -f /build/*.gcov "/shared/gcov/$n/" 2>/dev/null || true
        for g in /build/*-*.gcda /build/tests/audit/*-*.gcda /build/tests/oracle/*-*.gcda; do
            [ -e "$g" ] || continue
            n=$((n + 1))
            gcov "$g" >/dev/null 2>&1 || true
            mkdir -p "/shared/gcov/$n" && mv -f /build/*.gcov "/shared/gcov/$n/" 2>/dev/null || true
        done
        ;;
    audit)
        # Local audit: unit suite (seccomp enforcement) + fault matrix
        # (nft_handler_setup error returns under ASan/LSan + lifecycle
        # under valgrind). The 16-stage integration suite is opt-in and
        # off by default (AUDIT_RUN_INTEGRATION=1) — see tests/audit/run-all.sh.
        # Covers the gates the hosted CI cannot run for want of root/nft/
        # systemd/cgroup. Aggregated verdict in EC.
        ./tests/audit/run-all.sh || EC=$?
        cp -f /tmp/vg.log /shared/valgrind.log 2>/dev/null || true
        cp -f /tmp/asan_authnft.* /tmp/scen-*.out /shared/ 2>/dev/null || true
        ;;
    trace-features)
        make clean && make && make trace-features || EC=$?
        cp -f trace-features.log /shared/ 2>/dev/null || true
        ;;
    investigate)
        # Identify call stacks for specific syscalls observed on
        # Fedora but not on Arch (getuid, geteuid, statfs).
        # Reuses trace.sh's test user + PAM config setup inline.
        make clean >/dev/null && make >/dev/null
        mkdir -p /etc/authnft/users
        chmod 700 /etc/authnft /etc/authnft/users
        getent group authnft >/dev/null || groupadd authnft
        getent passwd authnft-test >/dev/null \
          || useradd -r -s /usr/sbin/nologin -G authnft authnft-test
        echo 'add rule inet authnft @session_chain socket cgroupv2 level 2 . ip saddr @session_v4 accept' \
          > /etc/authnft/users/authnft-test
        chown root:root /etc/authnft/users/authnft-test
        chmod 644 /etc/authnft/users/authnft-test
        cat > /etc/pam.d/authnft_test <<'PAM'
auth     required  pam_permit.so
account  required  pam_permit.so
session  required  /build/pam_authnft.so
password required  pam_deny.so
PAM
        AUTHNFT_NO_SANDBOX=1 strace -f -k \
            -e trace=geteuid,getuid,statfs \
            -o /shared/investigate.log \
            pamtester -I rhost=127.0.0.1 authnft_test authnft-test \
            open_session close_session >/dev/null 2>&1 || true
        ;;
    *)
        echo "Unknown workflow: $WORKFLOW" >&2
        EC=2
        ;;
esac

echo "$EC" > /shared/exit
# Dump what the test actually printed into the volume so the host
# sees it without needing to pull logs from the journal.
journalctl -u authnft-workflow.service --no-pager -o cat > /shared/log 2>&1 || true
sync
systemctl --no-block poweroff
